<%- include('partials/head', { title: 'Gestion des Utilisateurs' }) %>
<%- include('partials/nav') %>

<div class="dashboard-container">
  <div class="page-header">
    <h1>Gestion des Utilisateurs</h1>
    <button class="btn-primary" onclick="showModal('createModal')">+ Nouvel utilisateur</button>
  </div>

  <% if (typeof message !== 'undefined' && message) { %>
    <div class="alert alert-success"><%= message %></div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert alert-error"><%= error %></div>
  <% } %>

  <div class="table-wrapper">
    <table class="data-table">
      <thead>
        <tr>
          <th>Nom d'utilisateur</th>
          <th>Email</th>
          <th>Créé le</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% users.forEach(u => { %>
        <tr class="<%= u.email === currentUser.email ? 'row-current' : '' %>">
          <td>
            <strong><%= u.username %></strong>
            <% if (u.email === currentUser.email) { %>
              <span class="you-badge">vous</span>
            <% } %>
          </td>
          <td><%= u.email %></td>
          <td><%= new Date(u.createdAt).toLocaleDateString('fr-FR') %></td>
          <td class="actions">
            <button class="btn-sm btn-edit"
              onclick="showEditModal('<%= u.email %>', '<%= u.username %>')">
              Modifier
            </button>
            <% if (u.email !== currentUser.email) { %>
            <form action="/dashboard/users/<%= encodeURIComponent(u.email) %>/delete"
              method="POST" style="display:inline"
              onsubmit="return confirm('Supprimer l\'utilisateur <%= u.username %> ?')">
              <button type="submit" class="btn-sm btn-delete">Supprimer</button>
            </form>
            <% } %>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
<!-- Modal : Créer utilisateur -->
<div id="createModal" class="modal hidden">
  <div class="modal-content">
    <h2>Nouvel Utilisateur</h2>
    <form action="/dashboard/users" method="POST">
      <div class="form-group">
        <label>Nom d'utilisateur</label>
        <input type="text" name="username" minlength="3" required />
      </div>
      <div class="form-group">
        <label>Adresse email</label>
        <input type="email" name="email" required />
      </div>
      <div class="form-group">
        <label>Mot de passe <small>(min. 6 caractères)</small></label>
        <input type="password" name="password" minlength="6" required />
      </div>
      <div class="modal-actions">
        <button type="submit" class="btn-primary">Créer</button>
        <button type="button" class="btn-secondary" onclick="hideModal('createModal')">Annuler</button>
      </div>
    </form>
  </div>
</div>

<!-- Modal : Modifier utilisateur -->
<div id="editModal" class="modal hidden">
  <div class="modal-content">
    <h2>Modifier l'utilisateur</h2>
    <form id="editForm" method="POST">
      <div class="form-group">
        <label>Nom d'utilisateur</label>
        <input type="text" name="username" id="editUsername" minlength="3" />
      </div>
      <div class="form-group">
        <label>Nouveau mot de passe <small>(laisser vide pour ne pas changer)</small></label>
        <input type="password" name="password" minlength="6" />
      </div>
      <div class="modal-actions">
        <button type="submit" class="btn-primary">Enregistrer</button>
        <button type="button" class="btn-secondary" onclick="hideModal('editModal')">Annuler</button>
      </div>
    </form>
  </div>
</div>